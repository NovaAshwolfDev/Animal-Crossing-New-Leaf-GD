    <effect id="m0_effect_0" name="m_art_beauty">
      <profile_COMMON>
        <newparam sid="surface_0">
          <surface type="2D">
            <init_from>m0_image_2</init_from>
            <format>PNG</format>
          </surface>
        </newparam>
        <newparam sid="sampler_0">
          <sampler2D>
            <source>surface_0</source>
            <wrap_s>MIRROR</wrap_s>
            <wrap_t>MIRROR</wrap_t>
            <minfilter>LINEAR_MIPMAP_NEAREST</minfilter>
            <magfilter>LINEAR</magfilter>
            <mipfilter>LINEAR</mipfilter>
          </sampler2D>
        </newparam>
